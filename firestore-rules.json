{
  "rules": {
    "eventConfig": {
      "main": {
        ".read": true,
        ".write": false
      }
    },
    "templateConfig": {
      "main": {
        ".read": true,
        ".write": false
      }
    },
    "guests": {
      "{guestId}": {
        ".read": true,
        ".write": false,
        "attended": {
          ".write": "resource.id == request.auth.uid"
        }
      }
    }
  }
}
